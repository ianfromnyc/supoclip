# SupoClip Environment Configuration
# Copy this file and fill in your API keys

# ==============================================
# Docker Compose add-ons
# ==============================================
#
# The stack itself lives in docker-compose.yml, which is YOUR file — make it
# once with `cp docker-compose.yml.example docker-compose.yml` (./start.sh does
# this for you) and it stays untracked from then on.
#
# Optional pieces are turned on in two steps: uncomment their `include:` line
# at the top of that file, then copy the matching settings file. Each add-on
# keeps its own configuration, so none of it clutters this one:
#
#   docker/options/vaapi.yml     cp .env.vaapi.example .env.vaapi
#   docker/options/whisperx.yml  cp .env.whisperx.example .env.whisperx
#   docker/options/tunnel.yml    cp .env.tunnel.example .env.tunnel
#   docker/options/llama-*.yml   cp .env.llama.example .env.llama
#                                (uncomment exactly ONE llama variant; all five
#                                 share the one settings file)
#
# Half an add-on fails quietly — an include with no settings file starts an
# unconfigured service, a settings file with no include configures something
# that is not running — so ./start.sh warns about either.
#
# WHICH FILE DOES A SETTING GO IN?
#
#   This file          stack-level values Compose interpolates into
#                      docker-compose.yml (host ports, image build targets,
#                      LLAMA_MODELS_DIR) and anything shared across add-ons:
#                      API keys, auth secrets, URLs.
#   .env.<option>      that add-on's runtime configuration, passed straight
#                      into its containers.
#
# The split is not a style choice. Compose only expands ${...} from this file,
# never from a scoped one, and `environment:` entries in docker-compose.yml
# always beat env_file values — even when they expand to an empty string. So a
# variable can be owned by this file or by a scoped file, never both, and the
# compose file deliberately no longer mentions the ones listed above.
#
# UPGRADING? VIDEO_ENCODER, VAAPI_DEVICE, TRANSCRIPTION_PROVIDER, WHISPERX_*,
# HF_TOKEN and CLOUDFLARE_TUNNEL_TOKEN used to live here. Move your values into
# the matching .env.<option> — left here, they are now ignored.

# ==============================================
# AI Provider API Keys (Required for video processing)
# ==============================================

# AssemblyAI - Required for video transcription with word-level timing
ASSEMBLY_AI_API_KEY=
# Upload/transcription HTTP timeout in seconds. Larger videos need more time to upload.
ASSEMBLY_AI_HTTP_TIMEOUT_SECONDS=900

# Prefer to transcribe locally, with no AssemblyAI account at all? That is the
# whisperx add-on, and its settings — TRANSCRIPTION_PROVIDER, the WHISPERX_*
# knobs, HF_TOKEN — all live in .env.whisperx:
#
#   cp .env.whisperx.example .env.whisperx
#
# and uncomment docker/options/whisperx.yml in docker-compose.yml. Setting
# TRANSCRIPTION_PROVIDER here has no effect: the compose file does not pass it
# through any more.
#
# Not using Docker? config.py reads plain environment variables, so a
# bare-metal run can take WHISPERX_* from this file after
# `cd backend && uv sync --extra whisperx`.

# Choose one AI provider for transcript analysis:
# OpenAI, and any OpenAI-compatible endpoint (recommended: gpt-5.2)
# Required for the hosted OpenAI API; optional when OPENAI_BASE_URL points at a
# keyless endpoint such as a local llama.cpp/llama-swap, vLLM or Ollama server.
OPENAI_API_KEY=

# The endpoint openai:* models talk to. The default below is the hosted OpenAI
# API; change it to use any other OpenAI-compatible server. Examples:
#   http://llama:8080/v1                  (the llama.cpp add-on, see below)
#   http://localhost:8080/v1              (llama.cpp / llama-swap on the host)
#   http://host.docker.internal:11434/v1  (Ollama, from inside Docker)
#   https://openrouter.ai/api/v1          (OpenRouter)
# Always give this a real URL. A blank value is not the same as "use the
# default" - the OpenAI client reads it as an endpoint and every request fails.
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional per-request service tier for openai:* models: auto, default, flex,
# scale or priority. Leave empty to let OpenAI choose. Sent only by openai:*,
# never by the deprecated ollama:* prefix, and ignored by most self-hosted
# endpoints that do receive it.
OPENAI_SERVICE_TIER=

# Google AI (recommended: gemini-3-flash)
GOOGLE_API_KEY=

# Anthropic (claude-3-5-sonnet, claude-4-sonnet)
ANTHROPIC_API_KEY=

# DEPRECATED: the endpoint and key for the legacy LLM=ollama:* prefix only.
# It runs through the same OpenAI-compatible client — these variables just tell
# it where to connect — so existing installations keep working as they are.
# Prefer openai:<model> with OPENAI_BASE_URL for anything new.
# When left empty, ollama:* defaults to http://localhost:11434/v1 for local
# backend runs, or http://host.docker.internal:11434/v1 inside Docker.
# OPENAI_BASE_URL never applies to ollama:*, so the two prefixes cannot send
# your OpenAI key to a local server or your transcripts to OpenAI by accident.
OLLAMA_BASE_URL=
OLLAMA_API_KEY=

# Pexels - For AI B-Roll (free stock video footage)
# Get your free API key at: https://www.pexels.com/api/
PEXELS_API_KEY=

# Optional paid fallback for YouTube downloads
APIFY_API_TOKEN=

# YouTube download provider
# `yt_dlp` is the free default and works without APIFY_API_TOKEN.
# `apify` uses the Apify actor first, then falls back to yt-dlp.
YOUTUBE_DOWNLOAD_PROVIDER=yt_dlp

# YouTube metadata provider
# `yt_dlp` keeps the current behavior.
# `youtube_data_api` uses the official YouTube Data API first, then falls back to yt-dlp.
YOUTUBE_METADATA_PROVIDER=yt_dlp

# Preferred key for the YouTube Data API metadata path.
# If omitted, metadata requests fall back to GOOGLE_API_KEY when available.
YOUTUBE_DATA_API_KEY=

# ==============================================
# AI Model Configuration
# ==============================================

# Format: "provider:model-name"
# IMPORTANT: Hosted providers require the matching API key above. Local
# OpenAI-compatible endpoints usually need no key at all.
# Examples:
#   - openai:gpt-5.2 (requires OPENAI_API_KEY) - latest, best reasoning
#   - google-gla:gemini-3-flash-preview (requires GOOGLE_API_KEY) - fast, cost-effective
#   - anthropic:claude-4-sonnet (requires ANTHROPIC_API_KEY)
#   - openai:qwen3-coder with OPENAI_BASE_URL=http://localhost:8080/v1
#     (any OpenAI-compatible server: llama.cpp, vLLM, Ollama, OpenRouter, …)
#   - ollama:gpt-oss:20b - DEPRECATED alias of the openai:* path above
LLM=google-gla:gemini-3-flash-preview

# Running the model in the stack? Uncomment ONE docker/options/llama-*.yml
# include (cpu / cuda / rocm / sycl / vulkan), `cp .env.llama.example
# .env.llama`, drop a .gguf into models/ at the repo root — then set these
# two HERE, not in .env.llama, because compose passes them to the backend
# through `environment:`, which outranks any scoped file:
#   LLM=openai:local
#   OPENAI_BASE_URL=http://llama:8080/v1
#
# The server's own settings (which .gguf to load, GPU layers, context size) go
# in .env.llama. Only these two are stack-level, because compose has to
# interpolate them:
# Host directory holding your .gguf files, mounted read-only at /models.
# Default: the models/ directory at the repo root. An override must be an
# ABSOLUTE path — a relative value resolves against docker/options/ (where
# the llama add-on files live), not against the repo root.
# LLAMA_MODELS_DIR=/absolute/path/to/models
# Host port for llama.cpp's web UI (the stack itself uses the container port).
# LLAMA_PORT=9292

# Mark stale queued tasks as error after this many seconds
QUEUED_TASK_TIMEOUT_SECONDS=180

# Mark a processing task as error this many seconds after its last database
# update, but only when the worker that held it stopped sending heartbeats.
# Raise it if a render can go longer than this without writing progress.
PROCESSING_TASK_TIMEOUT_SECONDS=900

# How often the worker refreshes the heartbeat of a task it holds. The
# heartbeat key expires after three intervals.
TASK_HEARTBEAT_INTERVAL_SECONDS=30

# How often the API looks for tasks that no worker is working on.
# Set it to 0 to turn the sweep off.
TASK_SWEEP_INTERVAL_SECONDS=60

# How many videos the ARQ worker processes at once (default 4). Lower this
# when local GPU transcription/encoding shares one card, so concurrent jobs
# do not contend for VRAM.
WORKER_MAX_JOBS=4

# Default target resolution requested from the Apify YouTube downloader when enabled
APIFY_YOUTUBE_DEFAULT_QUALITY=1080
# Maximum Apify actor run time before SupoClip gives up and falls back, in seconds
APIFY_RUN_TIMEOUT_SECONDS=900

# Processing defaults
DEFAULT_PROCESSING_MODE=fast
FAST_MODE_MAX_CLIPS=4
FAST_MODE_TRANSCRIPT_MODEL=universal

# ==============================================
# Video Encoding (optional)
# ==============================================

# Clips render with libx264 on the CPU by default. To encode on an Intel or AMD
# GPU instead, that is the vaapi add-on:
#
#   cp .env.vaapi.example .env.vaapi
#
# and uncomment docker/options/vaapi.yml in docker-compose.yml. VIDEO_ENCODER
# and VAAPI_DEVICE live in that file — setting them here has no effect, because
# the compose file no longer passes them through.
#
# The device mapping is a separate switch from the encoder because a `devices:`
# entry fails container creation outright on hosts without /dev/dri. If a
# hardware encode fails at runtime, SupoClip warns and retries with libx264.

# ==============================================
# Authentication
# ==============================================

# Better Auth secret. ./start.sh replaces this placeholder with a secure random
# value on first run. If you run `docker compose` directly, set it yourself:
#   openssl rand -hex 32
BETTER_AUTH_SECRET=supoclip_dev_secret_change_in_production

# New user sign-ups are disabled by default — the frontend closes registration
# unless this is explicitly false, so leaving it unset is safe. Set it to false
# to let the public register, and review that before exposing the app via
# Cloudflare Tunnel or any other public ingress.
DISABLE_SIGN_UP=true

# Set to true to disable all routes except the landing page.
NEXT_PUBLIC_LANDING_ONLY_MODE=false

# ==============================================
# Cloudflare Tunnel (optional public ingress)
# ==============================================

# Reaching SupoClip from the internet without opening a port is the tunnel
# add-on:
#
#   cp .env.tunnel.example .env.tunnel
#
# and uncomment docker/options/tunnel.yml in docker-compose.yml. Your connector
# token goes in that file (as TUNNEL_TOKEN, cloudflared's own variable name),
# so your ingress credential lives in exactly one file. Deleting that file does
# NOT stop publishing the app: a running cloudflared keeps its token and
# restarts unless-stopped. To stop public ingress, comment the include back out
# and run `docker compose up -d --remove-orphans`; delete .env.tunnel afterwards
# to remove the credential from disk.
#
# In the tunnel's Public Hostname tab, add two hostnames on your zone:
#   app.example.com -> HTTP, frontend:3107
#   api.example.com -> HTTP, backend:8000
#
# The URLs below stay HERE, because the frontend bakes them into its image at
# build time and the backend needs the origin allow-listed — both of which are
# stack-level, not cloudflared's business.

# When exposing SupoClip through the tunnel, also point the app at the public
# hostnames (defaults are localhost; see docs/setup.md, "Public access with
# Cloudflare Tunnel"):
#   NEXT_PUBLIC_APP_URL=https://app.example.com
#   NEXT_PUBLIC_API_URL=https://api.example.com
#   BETTER_AUTH_URL=https://app.example.com
#   CORS_ORIGINS=https://app.example.com,http://localhost:3107,http://sp.localhost:3107,http://supoclip.localhost:3107

# ==============================================
# Analytics (optional)
# ==============================================

# DataFast public website ID (example: dfid_xxxxxx)
NEXT_PUBLIC_DATAFAST_WEBSITE_ID=

# DataFast tracked domain without protocol (example: supoclip.com)
NEXT_PUBLIC_DATAFAST_DOMAIN=

# Set to true only when you want to test DataFast on localhost
NEXT_PUBLIC_DATAFAST_ALLOW_LOCALHOST=false

# Amazon SES credentials for waitlist + subscription lifecycle emails (optional)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_FROM_EMAIL="SupoClip <onboarding@example.com>"
# Canonical frontend URL, used for email links and Stripe redirects. The right
# value depends on how you run SupoClip, so it is left unset by default: Docker
# compose already defaults it to http://localhost:3001, local `next dev` serves
# the app on http://localhost:3107, and deployments should set their own origin.
# NEXT_PUBLIC_APP_URL=http://localhost:3001

# ==============================================
# Monetization (optional, disabled by default)
# ==============================================

# Open-source/self-host mode. Monetization is only enabled when SELF_HOST=false
SELF_HOST=true
# ./start.sh replaces both placeholders below with secure random values on first
# run. If you run `docker compose` directly, set them yourself (for example with
# `openssl rand -hex 32`) — the placeholders are public, so leaving them in place
# lets anyone forge backend auth headers or decrypt stored admin settings.
BACKEND_AUTH_SECRET=change_me_backend_auth_secret
APP_SETTINGS_ENCRYPTION_KEY=change_me_settings_encryption_secret
ALLOW_UNSIGNED_BACKEND_AUTH=false
AUTH_SIGNATURE_TTL_SECONDS=300
# Include the frontend origin because browser video uploads go directly to the backend.
CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001,http://localhost:3107,http://sp.localhost:3107,http://supoclip.localhost:3107

# Hosted mode does not allow free processing. This is reserved for future use.
FREE_PLAN_TASK_LIMIT=10

# Paid plan monthly generation limits
PRO_PLAN_TASK_LIMIT=50
SCALE_PLAN_TASK_LIMIT=300

# Stripe settings (required only when SELF_HOST=false)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Legacy fallback for the Pro price ID. Prefer STRIPE_PRO_PRICE_ID for new setups.
STRIPE_PRICE_ID=
STRIPE_PRO_PRICE_ID=
STRIPE_SCALE_PRICE_ID=
NEXT_PUBLIC_PRO_PRICE_MONTHLY=10
NEXT_PUBLIC_SCALE_PRICE_MONTHLY=50
NEXT_PUBLIC_FREE_PLAN_TASK_LIMIT=10
NEXT_PUBLIC_PRO_PLAN_TASK_LIMIT=50
NEXT_PUBLIC_SCALE_PLAN_TASK_LIMIT=300

# Optional fallback links when Stripe sessions are not configured
STRIPE_CHECKOUT_URL=
STRIPE_CUSTOMER_PORTAL_URL=

# RevenueCat Apple IAP webhook settings (handled by the frontend Next.js route)
REVENUECAT_WEBHOOK_AUTH_HEADER=
# Optional comma-separated product ID overrides/additions. Defaults are:
# com.samihindi.supoclip.pro.monthly and com.samihindi.supoclip.scale.monthly
REVENUECAT_PRO_PRODUCT_IDS=
REVENUECAT_SCALE_PRODUCT_IDS=

# ==============================================
# Feedback (optional — posts to Discord)
# ==============================================

# Discord webhook URLs (each posts to a separate channel)
DISCORD_FEEDBACK_WEBHOOK_URL=
DISCORD_SALES_WEBHOOK_URL=

# ==============================================
# Database Configuration
# ==============================================

# PostgreSQL credentials (matches docker-compose.yml)
POSTGRES_DB=supoclip
POSTGRES_USER=supoclip
POSTGRES_PASSWORD=supoclip_password

# Redis password for Docker/local development.
# Leave blank to run Redis without AUTH, or set a value to require authentication.
REDIS_PASSWORD=

# ==============================================
# Docker Performance
# ==============================================

# Enable BuildKit for faster Docker builds
COMPOSE_DOCKER_CLI_BUILD=1
DOCKER_BUILDKIT=1
