# LLM Providers
# Required for hosted OpenAI; optional when OPENAI_BASE_URL points at a keyless
# OpenAI-compatible endpoint.
OPENAI_API_KEY=
# Optional endpoint override for openai:* models (llama.cpp/llama-swap, vLLM,
# Ollama, OpenRouter, …). Leave empty for the hosted OpenAI API.
OPENAI_BASE_URL=
# Optional per-request service tier: auto, default, flex, scale or priority.
OPENAI_SERVICE_TIER=
GOOGLE_API_KEY=
YOUTUBE_DATA_API_KEY=
ANTHROPIC_API_KEY=
# DEPRECATED: aliases of OPENAI_BASE_URL / OPENAI_API_KEY, read only by the
# legacy LLM=ollama:* prefix. When empty, ollama:* defaults to
# http://localhost:11434/v1 locally, or http://host.docker.internal:11434/v1
# inside Docker.
OLLAMA_BASE_URL=
OLLAMA_API_KEY=

# The AI Model to use throughout the app. Format: provider:model-name.
# Use openai:<model> with OPENAI_BASE_URL for any OpenAI-compatible endpoint.
LLM=google-gla:gemini-3-flash-preview

# Prevent tasks from sitting in queued forever if worker is down
QUEUED_TASK_TIMEOUT_SECONDS=180

# How many videos the ARQ worker processes at once (default 4). Lower this
# when local GPU transcription/encoding shares one card, so concurrent jobs
# do not contend for VRAM.
WORKER_MAX_JOBS=4

# YouTube metadata lookup provider: `yt_dlp` or `youtube_data_api`
YOUTUBE_METADATA_PROVIDER=yt_dlp

# Processing defaults
DEFAULT_PROCESSING_MODE=fast
FAST_MODE_MAX_CLIPS=4
FAST_MODE_TRANSCRIPT_MODEL=nano

# Video encoder: `libx264` (software, default) or `vaapi` (Intel GPU hardware
# encoding; falls back to libx264 per operation on failure).
VIDEO_ENCODER=libx264
# DRM render node for VAAPI. Find yours via `ls -l /dev/dri/by-path` or
# `vainfo --display drm --device /dev/dri/renderD129`.
VAAPI_DEVICE=/dev/dri/renderD128

# Good for speed optimizations
COMPOSE_BAKE=true

# DB
POSTGRES_DB=supoclip
POSTGRES_USER=supoclip
POSTGRES_PASSWORD=supoclip_password

# Not needed when TRANSCRIPTION_PROVIDER=whisperx
ASSEMBLY_AI_API_KEY=

# Transcription provider: `assemblyai` (cloud, default) or `whisperx` (fully
# local; install the optional extra first: `uv sync --extra whisperx`)
TRANSCRIPTION_PROVIDER=assemblyai
# WhisperX settings (only used when TRANSCRIPTION_PROVIDER=whisperx)
WHISPERX_MODEL=large-v3
# `auto` (default) picks cuda when a GPU is available, else cpu; or force `cuda`/`cpu`
WHISPERX_DEVICE=auto
# Defaults to float16 on cuda and int8 on cpu when left empty
WHISPERX_COMPUTE_TYPE=
# Per-word speaker labels via pyannote (requires HF_TOKEN)
WHISPERX_DIARIZE=true
# Hugging Face token with access to the pyannote diarization models
HF_TOKEN=

# Discord webhook URLs (each posts to a separate channel)
DISCORD_FEEDBACK_WEBHOOK_URL=
DISCORD_SALES_WEBHOOK_URL=

# Monetization (only enabled when SELF_HOST=false)
SELF_HOST=true
BACKEND_AUTH_SECRET=change_me_backend_auth_secret
APP_SETTINGS_ENCRYPTION_KEY=change_me_settings_encryption_secret
ALLOW_UNSIGNED_BACKEND_AUTH=false
AUTH_SIGNATURE_TTL_SECONDS=300
CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001,http://localhost:3107,http://sp.localhost:3107,http://supoclip.localhost:3107
# Hosted mode currently requires paid subscription to process tasks.
FREE_PLAN_TASK_LIMIT=10
PRO_PLAN_TASK_LIMIT=0
