# Settings for the tunnel add-on (docker/options/tunnel.yml).
#
#   cp .env.tunnel.example .env.tunnel
#
# Read by the cloudflared container only. Keeping the token here rather than in
# the root .env means the one file holding your ingress credential is also the
# file you delete to stop publishing the app.

# Connector token for a remotely-managed tunnel: Cloudflare Zero Trust ->
# Networks -> Tunnels -> Create a tunnel -> Cloudflared. TUNNEL_TOKEN is
# cloudflared's own variable name, which is why it is not called
# CLOUDFLARE_TUNNEL_TOKEN here.
TUNNEL_TOKEN=

# Hostname -> service routing is configured in the Cloudflare dashboard, not
# here. In the tunnel's Public Hostname tab, point the app hostname at
# http://frontend:3107 and the API hostname at http://backend:8000.
#
# Then set these in the root .env, because the frontend bakes them in at build
# time and the backend needs the origin allow-listed:
#   NEXT_PUBLIC_APP_URL=https://app.example.com
#   NEXT_PUBLIC_API_URL=https://api.example.com
#   BETTER_AUTH_URL=https://app.example.com
#   CORS_ORIGINS=https://app.example.com,http://localhost:3107
