# Settings for the vaapi add-on (docker/options/vaapi.yml).
#
#   cp .env.vaapi.example .env.vaapi
#
# Read by the backend and worker containers. This is the only place
# VIDEO_ENCODER and VAAPI_DEVICE are configured — the root .env no longer
# carries either name.
#
# To go back to software encoding, comment the vaapi.yml include back out of
# docker-compose.yml and run `docker compose up -d --remove-orphans`; delete
# this file afterwards. Deleting it on its own changes nothing, because the
# running containers keep the environment they were created with.

# `vaapi` encodes on the GPU via h264_vaapi; `libx264` is the software default.
# A hardware encode that fails at runtime is retried with libx264 automatically.
VIDEO_ENCODER=vaapi

# DRM render node to encode on. With more than one GPU, `ls -l /dev/dri/by-path`
# maps nodes to PCI devices, or probe one with
# `vainfo --display drm --device /dev/dri/renderD129`.
VAAPI_DEVICE=/dev/dri/renderD128
