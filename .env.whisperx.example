# Settings for the whisperx add-on (docker/options/whisperx.yml).
#
#   cp .env.whisperx.example .env.whisperx
#
# Read by three containers: the backend and worker (which transcribe by calling
# the service) and the whisperx service itself (which loads the model).
# TRANSCRIPTION_PROVIDER lives here and nowhere else, so the whole switch
# travels as one unit.
#
# To go back to AssemblyAI, comment the whisperx.yml include back out of
# docker-compose.yml and run `docker compose up -d --remove-orphans`; delete
# this file afterwards. Deleting it on its own leaves the running backend and
# worker still pointed at a service that is about to disappear.
#
# The variables are split by who reads them. ASR_* are the webservice image's
# own names, which is deliberate: compose only interpolates ${...} from the root
# .env, never from a scoped file, so a scoped file can only configure a service
# through the names that service already understands.

# ── Read by backend + worker ──────────────────────────────────────
# Transcribe locally instead of with AssemblyAI. No AssemblyAI key needed.
TRANSCRIPTION_PROVIDER=whisperx

# Where to reach the service. The compose hostname is right for the add-on;
# change it only if you host WhisperX somewhere else. Blank means "run WhisperX
# in this process", which needs the backend's optional `whisperx` extra and is
# only useful outside Docker.
WHISPERX_API_URL=http://whisperx:9000

# Ceiling on one transcription request. An hour is generous on purpose: a long
# video on a CPU-only host is genuinely slow.
WHISPERX_API_TIMEOUT_SECONDS=3600

# Ask for per-word speaker labels. Needs HF_TOKEN below; without one you still
# get a transcript, just no "Speaker A/B" attribution.
WHISPERX_DIARIZE=true

# ── Read by the whisperx service ──────────────────────────────────
# Whisper checkpoint. large-v3 is the most accurate; small or base are
# dramatically faster and worth trying first on a CPU-only host.
ASR_MODEL=large-v3

# ── Read by all three ─────────────────────────────────────────────
# Hugging Face token whose account has accepted the pyannote diarization model
# licences. Required for speaker labels, ignored otherwise.
HF_TOKEN=

# ── In-process only (bare metal, WHISPERX_API_URL blank) ──────────
# The add-on container picks its own model, device and precision, so these do
# nothing when you are running WhisperX over HTTP. Running SupoClip directly on
# the host instead? Put them in the root .env — config.py reads plain
# environment variables, and this file is a compose mechanism.
# Whisper checkpoint for the in-process path (ASR_MODEL above is the service's).
WHISPERX_MODEL=large-v3
# `auto` picks cuda when a GPU is available, else cpu; or force `cuda`/`cpu`.
WHISPERX_DEVICE=auto
# Blank derives from the device: float16 on cuda, int8 on cpu.
WHISPERX_COMPUTE_TYPE=
